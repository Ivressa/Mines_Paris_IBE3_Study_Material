% formulabook.sty -- shared layout of the formula booklets.
% A formula entry is one row of three columns: quantity (with its source in the notes),
% the formula, and the symbols, units and conditions. Set the colour theme with
%   \colorlet{theme}{...}   after \usepackage{formulabook}.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{formulabook}[2026/10/07 Formula booklets]

\RequirePackage[a4paper,hmargin=15mm,top=20mm,bottom=20mm,headsep=6mm,footskip=10mm]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
\RequirePackage{amsmath,amssymb,mathtools}
\RequirePackage{microtype}
\RequirePackage[table]{xcolor}
\RequirePackage[most]{tcolorbox}
\RequirePackage{siunitx}
\RequirePackage{array,booktabs,tabularx,multirow}
\RequirePackage{needspace}
\RequirePackage{fancyhdr,lastpage}
\RequirePackage{enumitem}
\RequirePackage{tikz}
\RequirePackage[hidelinks]{hyperref}

\definecolor{navy}{RGB}{31,58,104}
\definecolor{teal}{RGB}{20,90,110}
\definecolor{fbgray}{gray}{0.40}
\definecolor{fbrule}{gray}{0.80}
\definecolor{fbshade}{RGB}{234,240,250}
\definecolor{trapred}{RGB}{179,38,30}
\definecolor{trapbg}{RGB}{253,236,234}
\colorlet{theme}{navy}

\sisetup{per-mode=power, inter-unit-product=\ensuremath{\,}}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\emergencystretch=1.5em
\setlist{nosep, leftmargin=1.2em}

% --------------------------------------------------------------- header and footer
\newcommand{\booktitle}{Formula booklet}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{{\color{theme}\hrule height\headrulewidth}}
\fancyhead[L]{\small\color{theme}\bfseries\booktitle}
\fancyhead[R]{\small\color{fbgray}\nouppercase{\leftmark}}
\fancyfoot[L]{\scriptsize\color{fbgray}Unofficial study material}
\fancyfoot[R]{\small\thepage\,/\,\pageref{LastPage}}
\fancypagestyle{first}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[L]{\scriptsize\color{fbgray}Unofficial study material}%
  \fancyfoot[R]{\small\thepage\,/\,\pageref{LastPage}}}

% --------------------------------------------------------------- headings
% \partheading{Part I}{Electricity}: full-width banner; a new page only if little room is left
\newcommand{\partheading}[2]{%
  \par\Needspace{18\baselineskip}\vspace{10pt}%
  \begin{tcolorbox}[enhanced, colback=theme, colframe=theme, coltext=white, arc=1.5mm,
      boxrule=0pt, left=8pt, right=8pt, top=6pt, bottom=6pt]
    {\large\bfseries #1}\\[1pt]{\Large\bfseries #2}
  \end{tcolorbox}
  \addcontentsline{toc}{part}{#1\quad #2}\vspace{2pt}}
% \summaryheading{Summary}{Units}: same banner as a part, without a page break
\newcommand{\summaryheading}[2]{%
  \par\Needspace{14\baselineskip}\vspace{10pt}%
  \begin{tcolorbox}[enhanced, colback=theme, colframe=theme, coltext=white, arc=1.5mm,
      boxrule=0pt, left=8pt, right=8pt, top=6pt, bottom=6pt]
    {\large\bfseries #1}\\[1pt]{\Large\bfseries #2}
  \end{tcolorbox}
  \markboth{#2}{}%
  \addcontentsline{toc}{part}{#1\quad #2}\vspace{2pt}}
% \fbsection{2.4}{Atomic spectra}: section bar
\newcommand{\fbsection}[2]{%
  \par\Needspace{7\baselineskip}\vspace{7pt}%
  \begin{tcolorbox}[enhanced, colback=theme, colframe=theme, coltext=white, arc=1mm,
      boxrule=0pt, left=6pt, right=6pt, top=2.5pt, bottom=2.5pt, before skip=0pt,
      after skip=3pt]
    \bfseries #1\quad #2
  \end{tcolorbox}
  \markboth{#1\quad #2}{}%
  \addcontentsline{toc}{section}{#1\quad #2}}
% \fbsub{title}: small heading inside a section
\newcommand{\fbsub}[1]{%
  \par\Needspace{5\baselineskip}\vspace{4pt}%
  {\color{theme}\bfseries\small #1}\par\vspace{1pt}{\color{theme}\hrule height 0.6pt}\vspace{3pt}}

% --------------------------------------------------------------- formula entries
\newlength{\fbnamew}\setlength{\fbnamew}{0.215\textwidth}
\newlength{\fbformw}\setlength{\fbformw}{0.405\textwidth}
\newlength{\fbnotew}\setlength{\fbnotew}{0.345\textwidth}
\newcommand{\dagnote}{\textsuperscript{\color{trapred}\dag}}
% \fe[source]{quantity}{formula (math mode)}{symbols, units, conditions}
% \fe*[...]... marks the entry as not in the notes (dagger).
\NewDocumentCommand{\fe}{s O{} m m m}{%
  \par\noindent
  \begin{minipage}[c]{\fbnamew}\raggedright\small
    \textbf{#3}\IfBooleanT{#1}{\dagnote}%
    \if\relax\detokenize{#2}\relax\else\\[-1pt]{\scriptsize\color{fbgray}#2}\fi
  \end{minipage}\hfill
  \begin{minipage}[c]{\fbformw}\centering
    \vspace{2pt}$\displaystyle #4$\vspace{2pt}
  \end{minipage}\hfill
  \begin{minipage}[c]{\fbnotew}\raggedright\footnotesize #5\end{minipage}\par
  \vspace{2.5pt}{\color{fbrule}\hrule height 0.4pt}\vspace{2.5pt}}
% a note spanning the whole width, between entries
\newcommand{\fbnote}[1]{\par\noindent{\footnotesize #1}\par
  \vspace{2.5pt}{\color{fbrule}\hrule height 0.4pt}\vspace{2.5pt}}

% boxes
\newtcolorbox{keybox}[1][]{enhanced, colback=fbshade, colframe=theme, boxrule=0.5pt,
  arc=1mm, left=6pt, right=6pt, top=3pt, bottom=3pt, before skip=4pt, after skip=6pt,
  fonttitle=\bfseries\small, coltitle=white, colbacktitle=theme, #1}
\newtcolorbox{trapbox}[1][]{enhanced, colback=trapbg, colframe=trapred, boxrule=0.5pt,
  sharp corners, left=6pt, right=6pt, top=3pt, bottom=3pt, before skip=4pt, after skip=6pt,
  fonttitle=\bfseries\small, coltitle=white, colbacktitle=trapred, #1}

% \fbcontents prints the table of contents without a heading
\makeatletter
\newcommand{\fbcontents}{\@starttoc{toc}}
\makeatother

% table of contents: compact, two levels
\setcounter{tocdepth}{1}
\makeatletter
\renewcommand{\l@part}[2]{\par\vspace{3pt}\noindent{\bfseries\color{theme}#1}\hfill
  {\bfseries #2}\par}
\renewcommand{\l@section}{\@dottedtocline{1}{0.4em}{1.5em}}
\renewcommand{\@dotsep}{3}
\renewcommand{\@pnumwidth}{1.2em}
\renewcommand{\@tocrmarg}{2.2em plus 1fil}
\makeatother

\endinput
